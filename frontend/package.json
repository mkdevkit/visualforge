{
  "name": "@visualforge/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/check-node.cjs && concurrently -n api,web -c cyan,magenta \"tsx watch server/src/index.ts\" \"vite\"",
    "dev:web": "vite",
    "mcp": "tsx server/src/mcp-stdio.ts",
